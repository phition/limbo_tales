{
  "rules": {
    "users": {
      "$uid": {
        "profile": {
          ".read": true,
          ".write": true
        },
        "progress": {
          ".read": true,
          ".write": true
        },
        "ping": {
          ".read": true,
          ".write": true
        }
      }
    },
    "callsigns": {
      ".read": true,
      ".write": true
    },
    "guestbook": {
      ".read": true,
      ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      ".indexOn": ["createdAt"]
    },
    "arena_leaderboard": {
      ".read": true,
      ".write": true,
      ".indexOn": ["rating"]
    },
    "world_boss": {
      ".read": true,
      ".write": true,
      "nemesis": {
        ".read": true,
        ".write": true
      }
    },
    "game_data": {
      ".read": true,
      ".write": true
    }
  }
}
