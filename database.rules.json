{
  "rules": {
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid"
        },
        "progress": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "ping": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "callsigns": {
      ".read": true,
      "$callsign": {
        ".write": "auth != null"
      }
    },
    "guestbook": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "arena_leaderboard": {
      ".read": "auth != null",
      ".indexOn": ["rating"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'nickname', 'rating'])"
      }
    },
    "world_boss": {
      "nemesis": {
        ".read": true,
        ".write": true
      }
    },
    "game_data": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null && (auth.token.email.endsWith('@bumpcat.net') || auth.token.email.contains('bumpcat.net'))"
    }
  }
}
