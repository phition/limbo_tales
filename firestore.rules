rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // World boss collection (if accessed via Firestore)
    match /world_boss/{docId} {
      allow read, write: if true;
    }
    // Default rule for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
